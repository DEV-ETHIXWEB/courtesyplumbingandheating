# SMTP2GO (https://app.smtp2go.com) — required for the contact form, homepage
# quick-lead form, and chatbot lead capture to actually deliver email.
# Without SMTP2GO_API_KEY and LEAD_FROM_EMAIL set, the API routes return HTTP 500
# and every form shows its "call us" error — they never report a success for a
# lead that was not delivered (see src/pages/api/*.ts).
#
# Create at: Sending > API Keys, with the "Email: Send" permission.
SMTP2GO_API_KEY=

# The From address. Its domain (or the address itself) must be verified under
# Sending > Verified Senders, or SMTP2GO accepts the API call and then refuses the
# message. A display name is allowed: "Courtesy Plumbing <noreply@example.com>"
LEAD_FROM_EMAIL=

# Optional: where lead notification emails are sent. Falls back to
# business.email.display (src/data/business.ts) if unset.
LEAD_NOTIFICATION_EMAIL=

# Optional: only for EU-region or dedicated-IP SMTP2GO accounts, which are issued
# a different API host (e.g. https://api-eu.smtp2go.com/v3/email/send). Leave unset
# for a standard account. Verify after any change with `npm run check:mail`.
SMTP2GO_API_URL=

# Google Tag Manager container ID. If unset, no analytics script loads
# at all (src/components/analytics/Analytics.astro) — GA4, Google Ads,
# and Meta Pixel are all expected to be configured inside this GTM
# container, not hardcoded in the app.
PUBLIC_GTM_ID=
