# Resend (https://resend.com) — required for the contact form, homepage
# quick-lead form, and chatbot lead capture to actually deliver email.
# Without these two set, the API routes still return a success response
# to the visitor but silently drop the lead (see src/pages/api/*.ts).
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Optional: where lead notification emails are sent. Falls back to
# business.email.display (src/data/business.ts) if unset.
LEAD_NOTIFICATION_EMAIL=

# Google Tag Manager container ID. If unset, no analytics script loads
# at all (src/components/analytics/Analytics.astro) — GA4, Google Ads,
# and Meta Pixel are all expected to be configured inside this GTM
# container, not hardcoded in the app.
PUBLIC_GTM_ID=
