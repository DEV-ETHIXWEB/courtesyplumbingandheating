---
import { Phone, CalendarCheck, MessageCircle } from '@lucide/astro';
import { business } from '../../data/business';
---

<div
  class="fixed inset-x-0 bottom-0 z-(--z-mobile-bar) grid grid-cols-3 border-t border-border bg-white/95 backdrop-blur-sm shadow-elevated lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={business.phone.href}
    class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-xs font-semibold text-brand-red-700 min-h-11"
    data-analytics-event="phone_click"
    data-analytics-location="mobile_bar"
  >
    <Phone aria-hidden="true" class="size-5" />
    Call
  </a>
  <a
    href="/contact"
    class="flex flex-col items-center justify-center gap-0.5 border-x border-border bg-brand-blue-600 py-2.5 text-xs font-semibold text-white min-h-11"
    data-analytics-event="schedule_service_click"
    data-analytics-location="mobile_bar"
  >
    <CalendarCheck aria-hidden="true" class="size-5" />
    Book
  </a>
  <button
    type="button"
    class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-xs font-semibold text-brand-blue-700 min-h-11"
    data-chatbot-open
    data-analytics-event="chatbot_open"
    data-analytics-location="mobile_bar"
  >
    <MessageCircle aria-hidden="true" class="size-5" />
    Chat
  </button>
</div>
