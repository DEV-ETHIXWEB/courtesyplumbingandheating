---
import { X, ChevronDown, ArrowRight, Tag } from '@lucide/astro';
import { megaMenuGroups, secondaryNav } from '../../data/navigation';
import { business } from '../../data/business';
import { coupons } from '../../data/coupons';
import PhoneButton from '../ui/PhoneButton.astro';
import Button from '../ui/Button.astro';

const headlineCoupon = coupons.find((c) => c.featured) ?? coupons[0];
---

<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-(--z-mobile-menu) flex-col bg-white lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Main menu"
  data-mobile-menu
>
  <div class="flex items-center justify-between border-b border-border px-4 py-3">
    <span class="font-display text-lg font-bold text-brand-blue-700">Menu</span>
    <button
      type="button"
      class="flex size-11 items-center justify-center rounded-(--radius-md) text-text hover:bg-surface-muted"
      aria-label="Close menu"
      data-mobile-menu-close
    >
      <X aria-hidden="true" class="size-6" />
    </button>
  </div>

  <div class="flex-1 overflow-y-auto px-4 py-4">
    {headlineCoupon && (
      <a href="/coupons" class="mobile-coupon-card">
        <span class="mobile-coupon-card__icon">
          <Tag aria-hidden="true" class="size-4" />
        </span>
        <span class="flex-1">
          <span class="mobile-coupon-card__eyebrow">Limited-Time Special</span>
          <span class="mobile-coupon-card__title">
            {headlineCoupon.amount}{headlineCoupon.amountSuffix ? ` ${headlineCoupon.amountSuffix}` : ''}: {headlineCoupon.title}
          </span>
        </span>
        <ArrowRight aria-hidden="true" class="size-4 shrink-0 text-white/80" />
      </a>
    )}

    <div class="mb-4 grid grid-cols-2 gap-3">
      <PhoneButton variant="primary" location="mobile_menu" class="w-full" />
      <Button href="/contact" variant="secondary" class="w-full">Schedule Service</Button>
    </div>

    <div class="divide-y divide-border">
      {megaMenuGroups.map((group, i) => (
        <div class="py-2">
          <button
            type="button"
            class="flex w-full items-center justify-between py-3 text-left font-display text-base font-bold text-text"
            aria-expanded="false"
            aria-controls={`mobile-group-${i}`}
            data-mobile-accordion-trigger
          >
            {group.label}
            <ChevronDown aria-hidden="true" class="size-5 shrink-0 transition-transform duration-200 data-open:rotate-180" />
          </button>
          <div id={`mobile-group-${i}`} class="mobile-accordion-panel pb-2" data-mobile-accordion-panel>
            <ul class="grid grid-cols-1 gap-0.5">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="block rounded-(--radius-sm) px-2 py-2.5 text-sm text-text-muted hover:bg-brand-blue-50 hover:text-brand-blue-700">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
            <a href={group.href} class="mt-1 inline-flex items-center gap-1 px-2 py-1 text-sm font-semibold text-brand-blue-700">
              View all {group.label}
              <ArrowRight aria-hidden="true" class="size-4" />
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-2 border-t border-border pt-2">
      {secondaryNav.map((link) => (
        <a href={link.href} class="block rounded-(--radius-sm) px-2 py-3 font-semibold text-text hover:bg-surface-muted">
          {link.label}
        </a>
      ))}
      <a href="/service-area" class="block rounded-(--radius-sm) px-2 py-3 font-semibold text-text hover:bg-surface-muted">
        Service Areas
      </a>
    </div>
  </div>

  <div class="border-t border-border px-4 py-3 text-center text-sm text-text-muted">
    {business.address.full}
  </div>
</div>

<style>
  .mobile-coupon-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(155deg, var(--color-brand-red-600) 0%, var(--color-brand-red-800) 100%);
    box-shadow: 0 6px 16px -6px rgb(194 42 46 / 0.4);
  }

  .mobile-coupon-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.18);
    color: white;
  }

  .mobile-coupon-card__eyebrow {
    display: block;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
  }

  .mobile-coupon-card__title {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: white;
    line-height: 1.3;
  }
</style>

<script>
  function initMobileMenu() {
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const openBtn = document.querySelector<HTMLElement>('[data-mobile-menu-open]');
    const closeBtn = document.querySelector<HTMLElement>('[data-mobile-menu-close]');
    if (!menu || !openBtn || !closeBtn) return;

    // Guard against double-binding (script runs immediately AND on astro:page-load).
    if (menu.dataset.mobileBound === 'true') return;
    menu.dataset.mobileBound = 'true';

    const open = () => {
      menu.dataset.open = 'true';
      document.body.style.overflow = 'hidden';
      document.body.dataset.mobileMenuOpen = 'true';
      openBtn.setAttribute('aria-expanded', 'true');
      closeBtn.focus();
    };

    const close = () => {
      delete menu.dataset.open;
      document.body.style.overflow = '';
      delete document.body.dataset.mobileMenuOpen;
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    menu.querySelectorAll<HTMLButtonElement>('[data-mobile-accordion-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const panel = trigger.nextElementSibling as HTMLElement | null;
        const isOpen = trigger.dataset.open === 'true';
        if (isOpen) {
          delete trigger.dataset.open;
          trigger.setAttribute('aria-expanded', 'false');
          if (panel) delete panel.dataset.open;
        } else {
          trigger.dataset.open = 'true';
          trigger.setAttribute('aria-expanded', 'true');
          if (panel) panel.dataset.open = 'true';
        }
      });
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
