---
import { AlarmClockCheck } from '@lucide/astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import PhoneButton from '../ui/PhoneButton.astro';
---

<section class="relative overflow-hidden bg-[linear-gradient(115deg,var(--color-brand-red-700)_0%,var(--color-brand-red-800)_60%,var(--color-brand-red-900)_100%)] py-10 sm:py-12">
  <div
    class="pointer-events-none absolute inset-y-0 right-0 hidden w-1/3 opacity-[0.07] sm:block"
    aria-hidden="true"
    style="background-image: repeating-linear-gradient(115deg, white 0, white 2px, transparent 2px, transparent 28px);"
  ></div>

  <Container class="relative">
    <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left" data-reveal>
      <div class="flex items-center gap-4">
        <span class="relative hidden sm:flex size-14 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white ring-1 ring-inset ring-white/20">
          <span class="absolute inline-flex h-full w-full animate-ping-slow rounded-2xl bg-white/20 motion-reduce:hidden"></span>
          <AlarmClockCheck aria-hidden="true" class="relative size-7" />
        </span>
        <div>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-brand-red-100">
            <span class="relative flex size-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-white opacity-75 motion-reduce:hidden"></span>
              <span class="relative inline-flex size-1.5 rounded-full bg-white"></span>
            </span>
            Dispatching Now
          </span>
          <h2 class="mt-1 font-display text-2xl font-extrabold text-white sm:text-3xl">
            Plumbing or HVAC Emergency?
          </h2>
          <p class="mt-1 text-brand-red-50">We're available 24/7, with no trip fees, ever.</p>
        </div>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <PhoneButton variant="secondary" size="lg" location="emergency_cta" />
        <Button href="/contact" variant="outline" size="lg" class="border-white text-white hover:bg-white/10">
          Schedule Service
        </Button>
      </div>
    </div>
  </Container>
</section>
