---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import PhoneButton from '../ui/PhoneButton.astro';
import QuickLeadForm from '../forms/QuickLeadForm.tsx';
import { business } from '../../data/business';
---

<Section bg="navy" spacing="compact">
  <Container>
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="text-center lg:text-left" data-reveal>
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Ready When You Are.
        </h2>
        <p class="mt-4 text-lg text-text-inverse-muted">
          Send us the basics and we'll call you back, or talk to a real person right now, 24/7.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
          <PhoneButton variant="outline" size="lg" location="final_cta" class="text-white" />
        </div>
      </div>

      <div
        class="rounded-(--radius-xl) border border-white/15 bg-white/5 p-6 sm:p-8"
        data-reveal="right"
      >
        <h3 class="font-display text-xl font-bold text-white">Request Service</h3>
        <p class="mt-1.5 mb-5 text-sm text-white/60">Typical response within 1 business hour.</p>
        {/* client:idle, not client:visible: an unhydrated form would fall back to a
            native GET submit and silently lose the lead. */}
        <QuickLeadForm
          client:idle
          business={{ phoneDisplay: business.phone.display, phoneHref: business.phone.href }}
        />
      </div>
    </div>
  </Container>
</Section>
