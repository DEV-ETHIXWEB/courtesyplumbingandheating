---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import PhoneButton from '../ui/PhoneButton.astro';
---

<Section bg="navy" spacing="compact">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Ready When You Are.
      </h2>
      <p class="mt-4 text-lg text-text-inverse-muted">
        Schedule service online in minutes, or call and talk to a real person, 24/7.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/contact" variant="secondary" size="lg" showArrow>
          Schedule Service
        </Button>
        <PhoneButton variant="outline" size="lg" location="final_cta" class="text-white" />
      </div>
    </div>
  </Container>
</Section>
