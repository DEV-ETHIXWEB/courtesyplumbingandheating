---
import { Flame, Snowflake, Wrench, Droplets, WavesHorizontal, GitBranch, ArrowUpRight, PhoneCall } from '@lucide/astro';
import Container from '../ui/Container.astro';
import Reveal from '../ui/Reveal.astro';
import IconBadge from '../ui/IconBadge.astro';
import { business } from '../../data/business';

const categories = [
  {
    label: 'Heating',
    blurb: 'Furnace & boiler repair',
    href: '/hvac#heating',
    icon: Flame,
    tone: 'red' as const,
  },
  {
    label: 'Cooling',
    blurb: 'AC repair & tune-ups',
    href: '/hvac#cooling',
    icon: Snowflake,
    tone: 'blue' as const,
  },
  {
    label: 'Plumbing',
    blurb: 'Leaks, fixtures & repairs',
    href: '/plumbing',
    icon: Wrench,
    tone: 'navy' as const,
  },
  {
    label: 'Water Heaters',
    blurb: 'Tank & tankless service',
    href: '/plumbing/water-heater-repair',
    icon: Droplets,
    tone: 'blue' as const,
  },
  {
    label: 'Drains',
    blurb: 'Hydro jetting & clogs',
    href: '/plumbing/drain-cleaning',
    icon: WavesHorizontal,
    tone: 'navy' as const,
  },
  {
    label: 'Sewer',
    blurb: 'Line repair & inspection',
    href: '/sewer',
    icon: GitBranch,
    tone: 'red' as const,
  },
];
---

<section aria-labelledby="quick-service-heading" class="relative -mt-14 bg-surface-subtle sm:-mt-20 lg:-mt-24">
  <Container>
    <div
      class="relative overflow-hidden rounded-(--radius-xl) border border-border bg-white shadow-elevated"
      data-reveal
    >
      <div class="grid lg:grid-cols-[minmax(0,15rem)_1px_1fr]">
        <a
          href={business.phone.href}
          class="group relative flex flex-col justify-between gap-6 overflow-hidden bg-[linear-gradient(155deg,var(--color-brand-red-700)_0%,var(--color-brand-red-900)_100%)] p-6 text-white sm:p-7"
        >
          <div
            class="pointer-events-none absolute -top-10 -right-10 size-36 rounded-full bg-white/10 blur-2xl transition-transform duration-500 ease-(--ease-out-quart) group-hover:scale-125"
            aria-hidden="true"
          ></div>

          <div class="relative">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-brand-red-100">
              <span class="relative flex size-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-white opacity-75 motion-reduce:hidden"></span>
                <span class="relative inline-flex size-1.5 rounded-full bg-white"></span>
              </span>
              Live 24/7
            </span>
            <p class="mt-3 font-display text-xl font-extrabold leading-tight">
              Need help right now?
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-white/75">
              Skip the form. A real person answers, day or night.
            </p>
          </div>

          <div class="relative flex items-center justify-between gap-2 border-t border-white/15 pt-4">
            <span class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
              <PhoneCall aria-hidden="true" class="size-4 text-brand-red-200" />
              {business.phone.display}
            </span>
            <ArrowUpRight
              aria-hidden="true"
              class="size-5 shrink-0 text-white/70 transition-all duration-300 ease-(--ease-out-quart) group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white"
            />
          </div>
        </a>

        <div class="hidden bg-border lg:block" aria-hidden="true"></div>

        <div class="p-6 sm:p-7">
          <h2 id="quick-service-heading" class="text-sm font-bold uppercase tracking-wide text-text-muted">
            Or browse by what's going on
          </h2>

          <Reveal as="ul" class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-(--radius-lg) bg-border sm:grid-cols-3" step={40}>
            {categories.map(({ label, blurb, href, icon: Icon, tone }) => (
              <li data-reveal="scale" class="bg-white">
                <a
                  href={href}
                  class="group relative flex h-full flex-col gap-3 p-4 transition-colors duration-200 hover:bg-surface-subtle"
                >
                  <IconBadge icon={Icon} tone={tone} size="sm" />
                  <span>
                    <span class="block text-sm font-bold text-text">{label}</span>
                    <span class="mt-0.5 block text-xs leading-snug text-text-muted">{blurb}</span>
                  </span>
                  <ArrowUpRight
                    aria-hidden="true"
                    class="absolute right-3 top-3 size-4 text-neutral-300 opacity-0 transition-all duration-300 ease-(--ease-out-quart) group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand-blue-600 group-hover:opacity-100"
                  />
                </a>
              </li>
            ))}
          </Reveal>
        </div>
      </div>
    </div>
  </Container>
</section>
