---
import { Flame, Snowflake, Wrench, Droplets, WavesHorizontal, GitBranch, ArrowRight, PhoneCall, Zap } from '@lucide/astro';
import Reveal from '../ui/Reveal.astro';
import IconBadge from '../ui/IconBadge.astro';
import { business } from '../../data/business';

const categories = [
  {
    label: 'Heating',
    blurb: 'Furnace & boiler repair',
    href: '/hvac#heating',
    icon: Flame,
    tone: 'navy' as const,
  },
  {
    label: 'Cooling',
    blurb: 'AC repair & tune-ups',
    href: '/hvac#cooling',
    icon: Snowflake,
    tone: 'navy' as const,
  },
  {
    label: 'Plumbing',
    blurb: 'Leaks, fixtures & repairs',
    href: '/plumbing',
    icon: Wrench,
    tone: 'navy' as const,
  },
  {
    label: 'Water Heaters',
    blurb: 'Tank & tankless service',
    href: '/plumbing/water-heater-repair',
    icon: Droplets,
    tone: 'navy' as const,
  },
  {
    label: 'Drains',
    blurb: 'Hydro jetting & clogs',
    href: '/plumbing/drain-cleaning',
    icon: WavesHorizontal,
    tone: 'navy' as const,
  },
  {
    label: 'Sewer',
    blurb: 'Line repair & inspection',
    href: '/sewer',
    icon: GitBranch,
    tone: 'navy' as const,
  },
];
---

<section aria-labelledby="quick-service-heading" class="relative -mt-14 bg-surface-subtle sm:-mt-20 lg:-mt-24">
    <div
      class="relative overflow-hidden border-y border-border bg-white shadow-elevated"
      data-reveal
    >
      <div class="grid lg:grid-cols-[minmax(0,34rem)_1fr]">
        <!-- Emergency CTA panel -->
        <a
          href={business.phone.href}
          class="group relative flex flex-col justify-between overflow-hidden bg-[radial-gradient(120%_140%_at_0%_0%,var(--color-brand-red-500)_0%,var(--color-brand-red-700)_45%,var(--color-brand-red-900)_100%)] p-8 text-white sm:p-9 lg:pl-16 lg:pr-9"
        >
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.08]"
            aria-hidden="true"
            style="background-image: repeating-linear-gradient(115deg, white 0, white 1.5px, transparent 1.5px, transparent 22px);"
          ></div>
          <div
            class="pointer-events-none absolute -top-16 -right-16 size-56 rounded-full bg-white/10 blur-3xl transition-transform duration-500 ease-(--ease-out-quart) group-hover:scale-110"
            aria-hidden="true"
          ></div>
          <div
            class="pointer-events-none absolute -bottom-20 -left-10 size-48 rounded-full bg-black/10 blur-3xl"
            aria-hidden="true"
          ></div>

          <div class="relative lg:ml-8">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 py-1.5 pl-2 pr-3.5 text-[11px] font-bold uppercase tracking-wider text-white ring-1 ring-inset ring-white/20 backdrop-blur-sm">
              <span class="relative flex size-4 items-center justify-center">
                <span class="absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-white/40 motion-reduce:hidden"></span>
                <span class="relative flex size-2 rounded-full bg-white"></span>
              </span>
              Live 24/7
            </span>

            <p class="mt-5 font-display text-2xl font-extrabold leading-[1.1] text-balance sm:text-[1.75rem]">
              Emergency? We're already on our way.
            </p>
            <p class="mt-3 max-w-[26ch] text-sm leading-relaxed text-white/70 text-balance">
              Skip the form, talk to a real person right now, day or night.
            </p>
          </div>

          <div class="relative mt-10">
            <span class="inline-flex w-full items-center justify-between gap-3 rounded-2xl bg-white px-5 py-4 font-display text-lg font-bold tracking-tight text-brand-red-700 shadow-[0_8px_20px_-6px_rgba(0,0,0,0.35)] transition-all duration-250 ease-(--ease-out-quart) group-hover:-translate-y-0.5 group-hover:shadow-[0_12px_26px_-6px_rgba(0,0,0,0.4)]">
              <span class="flex items-center gap-2.5">
                <PhoneCall aria-hidden="true" class="size-[18px] shrink-0" />
                {business.phone.display}
              </span>
              <ArrowRight
                aria-hidden="true"
                class="size-[18px] shrink-0 transition-transform duration-250 ease-(--ease-out-quart) group-hover:translate-x-1"
              />
            </span>
          </div>
        </a>

        <!-- Service selector -->
        <div class="relative bg-surface-subtle p-6 sm:p-8 lg:p-9">
          <div class="flex items-baseline justify-between gap-4">
            <div>
              <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-brand-blue-600">
                <Zap aria-hidden="true" class="size-3.5" />
                Quick navigation
              </span>
              <h2 id="quick-service-heading" class="mt-1.5 font-display text-xl font-extrabold tracking-tight text-text sm:text-2xl">
                What's going on today?
              </h2>
            </div>
          </div>

          <Reveal as="ul" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3" step={40}>
            {categories.map(({ label, blurb, href, icon: Icon, tone }) => (
              <li data-reveal="scale">
                <a
                  href={href}
                  class="group/card relative flex h-full flex-col gap-3 rounded-(--radius-lg) border border-border bg-white p-4 shadow-[0_1px_2px_rgba(16,24,32,0.04)] transition-all duration-250 ease-(--ease-out-quart) hover:-translate-y-1 hover:border-transparent hover:shadow-[0_16px_32px_-12px_rgba(16,24,32,0.22)] sm:p-5"
                >
                  <div class="flex items-start justify-between">
                    <IconBadge icon={Icon} tone={tone} size="sm" />
                    <ArrowRight
                      aria-hidden="true"
                      class="size-4 shrink-0 -translate-x-1 text-neutral-300 opacity-0 transition-all duration-250 ease-(--ease-out-quart) group-hover/card:translate-x-0 group-hover/card:text-brand-blue-600 group-hover/card:opacity-100"
                    />
                  </div>
                  <span>
                    <span class="block text-sm font-bold text-text">{label}</span>
                    <span class="mt-1 block text-xs leading-snug text-text-muted">{blurb}</span>
                  </span>
                </a>
              </li>
            ))}
          </Reveal>
        </div>
      </div>
    </div>
</section>
