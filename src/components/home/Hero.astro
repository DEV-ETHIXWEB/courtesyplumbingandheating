---
import { Image } from 'astro:assets';
import { Clock, ShieldCheck, Award } from '@lucide/astro';
import heroPoster from '../../assets/photos/denver-hero-poster.jpg';
import Button from '../ui/Button.astro';
import PhoneButton from '../ui/PhoneButton.astro';
import { business } from '../../data/business';

const trustPoints = [
  { icon: Clock, label: '24/7 Emergency Service' },
  { icon: Award, label: `${business.yearsInBusiness} Years Serving Colorado` },
  { icon: ShieldCheck, label: 'No Trip Fees' },
];

---

<section class="relative overflow-hidden bg-neutral-950">
  <div class="absolute inset-0">
    {/*
      This image is the LCP element on the homepage. It sits behind a dark overlay
      and a video that fades in over it, so it carries compression well - hence
      quality 68. Widths are capped at the poster's own 1280px; asking for 1920
      would just upscale.
    */}
    <Image
      src={heroPoster}
      alt=""
      widths={[480, 640, 960, 1280]}
      sizes="100vw"
      quality={68}
      class="absolute inset-0 size-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      data-hero-poster
    />
    {/* Two clips that cross-fade into each other and loop: downtown Denver first,
        then the cliffs outside Colorado Springs. Neither element uses `loop` - the
        script hands playback from one to the other, and the pair repeats. The poster
        above is frame 0 of the first clip, so the still and the opening frame match. */}
    {[
      { key: 'denver', file: 'hero-denver' },
      { key: 'colorado', file: 'hero-colorado' },
    ].map(({ key, file }, index) => (
      <video
        class="absolute inset-0 size-full object-cover object-center opacity-0 transition-opacity duration-1000 ease-out"
        muted
        playsinline
        preload="none"
        data-hero-video={key}
        data-hero-index={index}
        aria-hidden="true"
      >
        {/* AV1 first, H.264 second: the browser takes the first source it can play.
            Measured with VMAF against the master, AV1 scored 84.5 where H.264 scored
            71.8 at the same file size, so AV1 buys real quality rather than bytes.
            The H.264 files are not redundant - Safari below 17 and older Android
            have no AV1 decoder, and they download only the source they pick.

            Sizes are deliberate. See docs/LAUNCH-READINESS.md: the hero video was
            once the LCP element at 6.0s, and these clips only stay out of that
            metric by being small and deferred. Re-measure before raising them. */}
        <source data-src={`/videos/${file}-mobile-av1.mp4`} type='video/mp4; codecs="av01.0.05M.08"' media="(max-width: 767px)" />
        <source data-src={`/videos/${file}-mobile.mp4`} type="video/mp4" media="(max-width: 767px)" />
        <source data-src={`/videos/${file}-av1.mp4`} type='video/mp4; codecs="av01.0.08M.08"' media="(min-width: 768px)" />
        <source data-src={`/videos/${file}.mp4`} type="video/mp4" media="(min-width: 768px)" />
      </video>
    ))}
  </div>

  <div class="relative mx-auto w-full max-w-(--container-max) px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
    <div class="max-w-2xl" data-reveal>
      {/* Solid pill with dark text. The previous light-red-on-10%-red version was
          unreadable over bright footage, and no tint of red on a moving background can
          be relied on - only an opaque backing gives a fixed contrast ratio.
          brand-red-700 on white is 7.4:1, so it holds over any frame. */}
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-red-200 bg-white/95 px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider text-brand-red-700 shadow-[0_2px_10px_rgba(0,0,0,0.25)]">
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-brand-red-500 opacity-75 motion-reduce:hidden"></span>
          <span class="relative inline-flex size-2 rounded-full bg-brand-red-600"></span>
        </span>
        24/7 Emergency Service
      </span>

      <h1 class="mt-6 text-balance font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-white drop-shadow-[0_2px_16px_rgba(0,0,0,0.75)] sm:text-5xl lg:text-6xl">
        Plumbing, Heating &amp; Cooling <span class="text-brand-blue-300">Done With Courtesy.</span>
      </h1>

      <p class="mt-6 max-w-xl text-balance text-lg leading-relaxed text-white/90 drop-shadow-[0_1px_10px_rgba(0,0,0,0.75)] sm:text-xl">
        Licensed, local, and available around the clock. Courtesy keeps Castle Rock and Denver
        Metro homes comfortable with transparent pricing and no trip fees.
      </p>

      <div class="mt-9 flex flex-col gap-3.5 sm:flex-row sm:items-center">
        <Button href="/contact" variant="primary" size="lg" showArrow>
          Schedule Service
        </Button>
        <PhoneButton variant="outline" size="lg" location="hero" class="text-white" />
      </div>

      <ul class="mt-9 flex flex-wrap gap-x-8 gap-y-3">
        {trustPoints.map(({ icon: Icon, label }) => (
          <li class="flex items-center gap-2 text-sm font-medium text-white drop-shadow-[0_1px_6px_rgba(0,0,0,0.75)]">
            <Icon aria-hidden="true" class="size-4 text-brand-blue-300" />
            {label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  /** Length of the CSS opacity transition on the video elements. */
  const FADE_MS = 1000;

  const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-hero-video]')].sort(
    (a, b) => Number(a.dataset.heroIndex) - Number(b.dataset.heroIndex)
  );

  if (videos.length) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection;
    const saveData = Boolean(connection?.saveData);
    const slowLink = connection?.effectiveType ? /^2g|slow-2g$/.test(connection.effectiveType) : false;

    if (!reduceMotion && !saveData && !slowLink) {
      let current = 0;
      let handedOff = false;

      const attachSources = (video: HTMLVideoElement) => {
        if (video.dataset.sourcesAttached === 'true') return;
        video.dataset.sourcesAttached = 'true';
        for (const source of video.querySelectorAll<HTMLSourceElement>('source[data-src]')) {
          source.src = source.dataset.src as string;
        }
        video.load();
      };

      const show = (video: HTMLVideoElement) => video.classList.remove('opacity-0');
      const hide = (video: HTMLVideoElement) => video.classList.add('opacity-0');

      // The outgoing clip keeps playing through the fade and then fires 'ended'. Left
      // attached, that handler advances a second time and swaps straight back, so a
      // clip's listeners are always detached as it hands over.
      const listeners = new WeakMap<HTMLVideoElement, () => void>();
      const unwatch = (video: HTMLVideoElement) => {
        listeners.get(video)?.();
        listeners.delete(video);
      };

      /**
       * Cross-fade to the next clip. The outgoing video keeps playing through the
       * fade and is only reset once it is fully transparent, so the swap is never
       * visible as a jump or a black frame.
       */
      const advance = () => {
        if (handedOff) return;
        handedOff = true;

        const outgoing = videos[current];
        const next = (current + 1) % videos.length;
        const incoming = videos[next];

        unwatch(outgoing);
        attachSources(incoming);
        incoming.currentTime = 0;

        const begin = () => {
          show(incoming);
          hide(outgoing);
          incoming.play().catch(() => show(outgoing));
          current = next;
          handedOff = false;
          window.setTimeout(() => {
            outgoing.pause();
            outgoing.currentTime = 0;
          }, FADE_MS);
          watch(incoming);
        };

        if (incoming.readyState >= 3) begin();
        else incoming.addEventListener('canplay', begin, { once: true });
      };

      /**
       * Hand over slightly before the clip ends so the fade completes on moving
       * footage. 'ended' is kept as a backstop: if timeupdate stops firing, or the
       * duration is unknown, playback still advances instead of freezing.
       */
      const watch = (video: HTMLVideoElement) => {
        const onTime = () => {
          if (!Number.isFinite(video.duration)) return;
          if (video.duration - video.currentTime <= FADE_MS / 1000) advance();
        };
        const onEnded = () => advance();

        video.addEventListener('timeupdate', onTime);
        video.addEventListener('ended', onEnded);
        listeners.set(video, () => {
          video.removeEventListener('timeupdate', onTime);
          video.removeEventListener('ended', onEnded);
        });
      };

      // Deferred deliberately. Once a video paints it becomes the LCP element, and
      // starting playback during load pushed mobile LCP to 6.0s. Waiting for load +
      // idle leaves the poster image as LCP; the first clip fades in over it.
      const startPlayback = () => {
        const first = videos[0];
        attachSources(first);

        first.addEventListener(
          'canplay',
          () => {
            show(first);
            watch(first);
            // Only fetch the second clip once the first is actually playing, so the
            // two never compete for bandwidth during the initial load.
            window.setTimeout(() => attachSources(videos[1]), 2000);
          },
          { once: true }
        );

        first.play().catch(() => {
          // Autoplay blocked or load failed: the poster image underneath stays visible.
        });
      };

      const schedule = () => {
        const idle = (window as unknown as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void })
          .requestIdleCallback;
        // Safari has no requestIdleCallback; a short timeout is close enough.
        if (idle) idle(startPlayback, { timeout: 2000 });
        else setTimeout(startPlayback, 600);
      };

      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    }
  }
</script>
