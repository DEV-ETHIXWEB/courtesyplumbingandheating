---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import StatCounter from '../ui/StatCounter.tsx';
import { business } from '../../data/business';
import { locations } from '../../data/locations';

const yearsValue = Number.parseInt(business.yearsInBusiness, 10) || 30;

const stats = [
  { value: yearsValue, suffix: '+', label: 'Years Serving Colorado' },
  { value: 24, suffix: '/7', label: 'Emergency Availability' },
  { value: locations.length, suffix: '', label: 'Communities Served' },
  { value: 0, suffix: '', label: 'Trip Fees, Ever' },
];
---

<Section bg="navy">
  <Container class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div data-reveal="left">
      <Eyebrow tone="dark">Why Courtesy</Eyebrow>
      <h2 class="mt-4 text-balance font-display text-3xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-4xl md:text-[2.75rem]">
        Service With Courtesy.
      </h2>
      <p class="mt-5 max-w-lg text-balance leading-relaxed text-text-inverse-muted">
        We built our name on doing the job right, explaining the problem clearly, and treating
        every home like our own. Licensed technicians, transparent pricing, and no trip fees, day
        or night.
      </p>

      <dl class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-4 lg:grid-cols-2">
        {stats.map((s) => (
          <div class="border-l-2 border-brand-blue-400 pl-4">
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-3xl font-bold text-white">
              <StatCounter value={s.value} suffix={s.suffix} client:visible />
            </dd>
            <dd class="mt-1 text-xs font-medium uppercase tracking-wide text-brand-blue-200">{s.label}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-10">
        <Button href="/about" variant="secondary" showArrow>
          More About Courtesy
        </Button>
      </div>
    </div>

    <div class="relative" data-reveal="right">
      <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-blue-500/20 to-brand-red-500/10 blur-2xl" aria-hidden="true"></div>
      <div class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-8 sm:p-10">
        <p class="font-display text-lg font-bold text-white">Licensed &amp; Insured</p>
        <p class="mt-2 text-sm leading-relaxed text-text-inverse-muted">
          Courtesy holds Colorado plumbing license #{business.license.plumbing}. Transparent
          pricing and no trip fees on every call.
        </p>
        <div class="mt-8 grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="font-display text-2xl font-bold text-white">No</p>
            <p class="mt-1 text-xs text-text-inverse-muted">Surprise charges</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="font-display text-2xl font-bold text-white">24/7</p>
            <p class="mt-1 text-xs text-text-inverse-muted">Emergency service</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
