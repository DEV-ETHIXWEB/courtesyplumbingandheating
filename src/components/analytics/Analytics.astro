---
// Google Tag Manager container. GTM then manages GA4, Google Ads, Meta, and
// CallRail from within the container, so no other vendor scripts belong here.
// Set PUBLIC_GTM_ID in the environment to activate; absent it, nothing loads.
//
// The container is NOT injected on page load. It loads only once the visitor has
// accepted in the consent banner (see ConsentBanner.astro), and on later visits
// only if that acceptance is still stored. Declining leaves the site tag-free.
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

{
  gtmId && (
    <script is:inline define:vars={{ gtmId }}>
      // Stashed on <html> so the consent module can read it without re-templating.
      document.documentElement.dataset.gtmId = gtmId;
      window.dataLayer = window.dataLayer || [];
    </script>
  )
}

{
  gtmId && (
    <script>
      import { readConsent, loadGtm } from '../../scripts/consent';

      function applyStoredConsent() {
        if (readConsent() === 'granted') loadGtm();
      }

      applyStoredConsent();
      document.addEventListener('astro:page-load', applyStoredConsent);
    </script>
  )
}

<script>
  // Delegated tracking for declaratively-marked elements. Any element with
  // data-analytics-event pushes that event on click, with its location label.
  // Events are pushed to dataLayer regardless of consent; without consent the
  // container is never loaded, so nothing consumes or transmits them.
  function initAnalytics() {
    if (document.body.dataset.analyticsBound === 'true') return;
    document.body.dataset.analyticsBound = 'true';

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-analytics-event]');
      if (!target) return;
      const event = target.dataset.analyticsEvent;
      if (!event) return;
      const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({
        event,
        link_location: target.dataset.analyticsLocation || undefined,
      });
    });
  }

  initAnalytics();
  document.addEventListener('astro:page-load', initAnalytics);
</script>
