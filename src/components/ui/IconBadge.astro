---
import type { AstroComponent } from '@lucide/astro';

interface Props {
  icon: AstroComponent;
  class?: string;
  tone?: 'blue' | 'red' | 'navy' | 'white';
  size?: 'sm' | 'md' | 'lg';
}

const { icon: Icon, class: className = '', tone = 'blue', size = 'md' } = Astro.props;

const sizes = {
  sm: 'size-9 [&>svg]:size-4',
  md: 'size-12 [&>svg]:size-5',
  lg: 'size-16 [&>svg]:size-7',
};

const tones = {
  blue: {
    badge:
      'text-brand-blue-800 ring-1 ring-inset ring-brand-blue-500/30 [background:linear-gradient(155deg,var(--color-brand-blue-100)_0%,var(--color-brand-blue-300)_55%,var(--color-brand-blue-400)_100%)]',
    shadow:
      'shadow-[inset_0_1.5px_1.5px_rgba(255,255,255,0.85),inset_0_-6px_10px_-4px_rgba(15,76,135,0.35),0_10px_20px_-8px_rgba(15,95,168,0.45),0_2px_6px_-1px_rgba(15,95,168,0.25)]',
  },
  red: {
    badge:
      'text-brand-red-800 ring-1 ring-inset ring-brand-red-500/30 [background:linear-gradient(155deg,var(--color-brand-red-100)_0%,var(--color-brand-red-300)_55%,var(--color-brand-red-400)_100%)]',
    shadow:
      'shadow-[inset_0_1.5px_1.5px_rgba(255,255,255,0.85),inset_0_-6px_10px_-4px_rgba(161,33,36,0.35),0_10px_20px_-8px_rgba(219,63,67,0.45),0_2px_6px_-1px_rgba(219,63,67,0.25)]',
  },
  navy: {
    badge:
      'text-brand-blue-100 ring-1 ring-inset ring-brand-blue-500/40 [background:linear-gradient(155deg,var(--color-brand-blue-700)_0%,var(--color-brand-blue-900)_55%,var(--color-brand-navy)_100%)]',
    shadow:
      'shadow-[inset_0_1.5px_1.5px_rgba(255,255,255,0.15),inset_0_-6px_10px_-4px_rgba(0,0,0,0.35),0_10px_20px_-8px_rgba(10,46,77,0.55),0_2px_6px_-1px_rgba(10,46,77,0.35)]',
  },
  white: {
    badge:
      'text-brand-blue-600 ring-1 ring-inset ring-white/60 [background:linear-gradient(155deg,white_0%,var(--color-brand-blue-50)_100%)]',
    shadow:
      'shadow-[inset_0_1.5px_1.5px_rgba(255,255,255,0.9),inset_0_-4px_8px_-4px_rgba(15,95,168,0.15),0_10px_20px_-8px_rgba(11,13,16,0.25),0_2px_6px_-1px_rgba(11,13,16,0.12)]',
  },
};

const t = tones[tone];
---

<span
  class:list={[
    'relative inline-flex shrink-0 items-center justify-center rounded-2xl transition-[transform,box-shadow] duration-300 ease-(--ease-out-quart) group-hover:-translate-y-0.5 group-hover:-rotate-2',
    sizes[size],
    t.badge,
    t.shadow,
    className,
  ]}
>
  <Icon
    aria-hidden="true"
    stroke-width={2.25}
    class="[filter:drop-shadow(0_1px_1px_rgba(255,255,255,0.6))_drop-shadow(0_1.5px_0.5px_rgba(0,0,0,0.12))] transition-transform duration-300 ease-(--ease-out-quart) group-hover:scale-110"
  />
</span>
