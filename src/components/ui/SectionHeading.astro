---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  class?: string;
}

const { eyebrow, title, description, align = 'center', tone = 'light', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex flex-col gap-4',
    align === 'center' ? 'items-center text-center' : 'items-start text-left',
    className,
  ]}
  data-reveal
>
  {eyebrow && <Eyebrow tone={tone === 'light' ? 'light' : 'dark'}>{eyebrow}</Eyebrow>}
  <h2
    class:list={[
      'text-balance font-display text-3xl font-extrabold leading-[1.05] tracking-tight sm:text-4xl md:text-[2.75rem]',
      tone === 'light' ? 'text-text' : 'text-white',
    ]}
  >
    {title}
  </h2>
  {
    description && (
      <p
        class:list={[
          'max-w-2xl text-balance text-base leading-relaxed sm:text-lg',
          tone === 'light' ? 'text-text-muted' : 'text-text-inverse-muted',
        ]}
      >
        {description}
      </p>
    )
  }
</div>
