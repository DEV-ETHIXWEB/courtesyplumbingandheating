---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import PhoneButton from '../../components/ui/PhoneButton.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import { Calendar, User } from '@lucide/astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: post.data.title },
];
---

<BaseLayout title={post.data.title} description={post.data.description} canonical={`/blog/${post.id}`}>
  <BreadcrumbSchema items={breadcrumbItems} />
  <ArticleSchema
    title={post.data.title}
    description={post.data.description}
    date={post.data.date}
    author={post.data.author}
    path={`/blog/${post.id}`}
  />

  <Section spacing="compact">
    <Container>
      <Breadcrumb items={breadcrumbItems} class="mb-6" />
      <div class="mx-auto max-w-3xl" data-reveal>
        {post.data.category && (
          <span class="inline-flex rounded-full bg-brand-blue-50 px-3 py-1 text-xs font-semibold text-brand-blue-700">
            {post.data.category}
          </span>
        )}
        <h1 class="mt-4 text-balance font-display text-3xl font-extrabold leading-[1.1] tracking-tight text-text sm:text-4xl">
          {post.data.title}
        </h1>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-text-muted">
          <span class="flex items-center gap-1.5">
            <User aria-hidden="true" class="size-4" />
            {post.data.author}
          </span>
          <span class="flex items-center gap-1.5">
            <Calendar aria-hidden="true" class="size-4" />
            <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
          </span>
        </div>
      </div>
    </Container>
  </Section>

  <Section spacing="none">
    <Container>
      <div class="prose-article mx-auto max-w-3xl pb-4" data-reveal>
        <Content />
      </div>
    </Container>
  </Section>

  <Section bg="subtle">
    <Container>
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 rounded-(--radius-xl) border border-border bg-surface p-8 text-center sm:p-10" data-reveal>
        <h2 class="font-display text-xl font-bold text-text">Need Help With This in Your Home?</h2>
        <p class="max-w-md text-sm text-text-muted">
          Courtesy Plumbing & Heating provides licensed plumbing, heating, and cooling service throughout Castle
          Rock and the Denver Metro area, available 24/7 with no trip fees.
        </p>
        <div class="mt-1 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="primary" showArrow>Schedule Service</Button>
          <PhoneButton variant="secondary" location="blog_post_cta" />
        </div>
      </div>
    </Container>
  </Section>

  {related.length > 0 && (
    <Section>
      <Container>
        <h2 class="font-display text-2xl font-bold text-text">More {post.data.category}</h2>
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-3">
          {related.map((r) => (
            <a href={`/blog/${r.id}`} class="card-elevated group flex flex-col p-5">
              <h3 class="font-display text-base font-bold text-text group-hover:text-brand-blue-700">{r.data.title}</h3>
              <p class="mt-2 flex-1 text-sm text-text-muted line-clamp-2">{r.data.description}</p>
            </a>
          ))}
        </div>
      </Container>
    </Section>
  )}
</BaseLayout>

<style is:global>
  .prose-article {
    color: var(--color-text);
    line-height: 1.75;
  }
  .prose-article h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .prose-article h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .prose-article p {
    margin-top: 1rem;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }
  .prose-article ul,
  .prose-article ol {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
  }
  .prose-article ul {
    list-style: disc;
  }
  .prose-article ol {
    list-style: decimal;
  }
  .prose-article li {
    margin-top: 0.375rem;
  }
  .prose-article a {
    color: var(--color-brand-blue-700);
    font-weight: 600;
    text-underline-offset: 2px;
  }
  .prose-article a:hover {
    text-decoration: underline;
  }
  .prose-article strong {
    color: var(--color-text);
    font-weight: 700;
  }
  .prose-article blockquote {
    margin: 1.5rem 0;
    border-left: 3px solid var(--color-brand-blue-400);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-text-muted);
  }
</style>
