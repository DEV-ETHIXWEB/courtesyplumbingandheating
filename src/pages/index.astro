---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import QuickServiceSelector from '../components/home/QuickServiceSelector.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import EmergencyCTA from '../components/home/EmergencyCTA.astro';
import ServiceAreaSection from '../components/home/ServiceAreaSection.astro';
import OffersSection from '../components/home/OffersSection.astro';
import WhyCourtesy from '../components/home/WhyCourtesy.astro';
import ReviewSection from '../components/home/ReviewSection.astro';
import BlogPreview from '../components/home/BlogPreview.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { getImage } from 'astro:assets';
import heroPoster from '../assets/photos/denver-hero-poster.jpg';

// The hero poster is this page's LCP element. Preloading it from <head> starts the
// fetch before the parser reaches the <img>, which is worth a few hundred ms on a
// throttled phone. Widths/quality must stay in step with the <Image> in Hero.astro,
// or the browser preloads a variant the markup never asks for.
const heroPreload = await getImage({
  src: heroPoster,
  widths: [480, 640, 960, 1280, 1920],
  sizes: '100vw',
  format: 'webp',
  quality: 68,
});
---

<BaseLayout
  title="Courtesy Plumbing & Heating | Castle Rock & Denver Metro"
  description="Licensed plumbing, heating, and cooling service in Castle Rock and the Denver Metro area. 24/7 emergency service, transparent pricing, no trip fees."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href={heroPreload.src}
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes="100vw"
    fetchpriority="high"
  />

  <Hero />
  <QuickServiceSelector />
  <TrustStrip />
  <ServicesOverview />
  <EmergencyCTA />
  <OffersSection />
  <WhyCourtesy />
  <ReviewSection />
  <ServiceAreaSection />
  <BlogPreview />
  <FinalCTA />
</BaseLayout>
