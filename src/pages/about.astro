---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Reveal from '../components/ui/Reveal.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import StatCounter from '../components/ui/StatCounter.tsx';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ReviewSection from '../components/home/ReviewSection.astro';
import EmergencyCTA from '../components/home/EmergencyCTA.astro';
import { Clock, DollarSign, ShieldCheck, HeartHandshake, Users } from '@lucide/astro';
import { business } from '../data/business';
import { locations } from '../data/locations';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'About' }];

const values = [
  { icon: HeartHandshake, title: 'Courtesy, By Name', description: 'We treat every home like our own: clean work, clear communication, and respect for your time.' },
  { icon: DollarSign, title: 'Transparent Pricing', description: 'No trip fees, ever. You know the cost before we start any work.' },
  { icon: Clock, title: 'Available 24/7', description: 'Plumbing and HVAC emergencies don\'t wait for business hours, so neither do we.' },
  { icon: ShieldCheck, title: 'Licensed & Insured', description: `Colorado plumbing license #${business.license.plumbing}, with technicians who take safety seriously.` },
];

const stats = [
  { value: 30, suffix: '+', label: 'Years Serving Colorado' },
  { value: locations.length, suffix: '', label: 'Communities Served' },
  { value: 24, suffix: '/7', label: 'Emergency Availability' },
  { value: 0, suffix: '', label: 'Trip Fees, Ever' },
];

const title = 'About Courtesy Plumbing & Heating';
const description = `Learn about Courtesy Plumbing & Heating: ${business.yearsInBusiness} years serving Castle Rock and the Denver Metro area with licensed, transparent plumbing and HVAC service.`;
---

<BaseLayout title={title} description={description} canonical="/about">
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <Eyebrow tone="dark">Our Story</Eyebrow>
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          {business.yearsInBusiness} Years of Service With Courtesy
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          Courtesy Plumbing & Heating has served Castle Rock and the Denver Metro area with licensed plumbing, heating, and cooling service built on honesty and respect for your home.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="secondary" size="lg" showArrow>Schedule Service</Button>
          <PhoneButton variant="outline" size="lg" location="about_hero" class="text-white" />
        </div>
      </div>

      <dl class="mt-14 grid grid-cols-2 gap-6 border-t border-white/10 pt-10 sm:grid-cols-4" data-reveal>
        {stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-3xl font-bold text-white">
              <StatCounter value={s.value} suffix={s.suffix} client:visible />
            </dd>
            <dd class="mt-1 text-xs font-medium uppercase tracking-wide text-brand-blue-200">{s.label}</dd>
          </div>
        ))}
      </dl>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div data-reveal="left">
          <Eyebrow>Who We Are</Eyebrow>
          <h2 class="mt-4 font-display text-2xl font-bold text-text sm:text-3xl">
            A Local Team You Can Actually Trust
          </h2>
          <div class="mt-5 space-y-4 leading-relaxed text-text-muted">
            <p>
              Courtesy Plumbing & Heating is headquartered in Castle Rock, Colorado, with a second office serving
              Federal Heights and the north metro area. For {business.yearsInBusiness} years, we've provided
              licensed plumbing, heating, and cooling service throughout the Denver Metro area.
            </p>
            <p>
              We built our name on doing the job right the first time, explaining problems in plain language, and
              treating every home like our own. That means licensed technicians, transparent pricing with no trip
              fees, and availability around the clock for the emergencies that can't wait.
            </p>
            <p>
              Whether it's a dripping faucet, a furnace that won't start, or a full system replacement, our goal is
              the same: honest work, fair pricing, and a team you'd be comfortable calling again.
            </p>
          </div>
        </div>
        <div class="relative" data-reveal="right">
          <div class="rounded-[2rem] border border-border bg-surface-subtle p-8 sm:p-10">
            <p class="font-display text-lg font-bold text-text">Two Offices, One Standard of Service</p>
            <div class="mt-6 space-y-5">
              <div class="rounded-2xl border border-border bg-white p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-blue-600">Headquarters</p>
                <p class="mt-1 font-display text-base font-bold text-text">Castle Rock</p>
                <p class="mt-1 text-sm text-text-muted">{business.address.full}</p>
              </div>
              <div class="rounded-2xl border border-border bg-white p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-blue-600">North Metro Office</p>
                <p class="mt-1 font-display text-base font-bold text-text">Federal Heights</p>
                <p class="mt-1 text-sm text-text-muted">{business.secondaryAddress.full}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section bg="subtle">
    <Container>
      <SectionHeading eyebrow="What We Stand For" title="Our Values" />
      <Reveal as="div" class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4" step={70}>
        {values.map((v) => (
          <div class="card-elevated flex flex-col items-start gap-3 p-6" data-reveal>
            <IconBadge icon={v.icon} tone="blue" size="md" />
            <h3 class="font-display text-base font-bold text-text">{v.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted">{v.description}</p>
          </div>
        ))}
      </Reveal>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="card-elevated flex flex-col items-center gap-4 p-10 text-center" data-reveal>
        <IconBadge icon={Users} tone="navy" size="lg" />
        <h2 class="font-display text-2xl font-bold text-text">Join Our Team</h2>
        <p class="max-w-xl text-text-muted">
          We're always looking for qualified HVAC technicians, plumbers, and apprentices to join a team that values
          honest work and treats employees like family.
        </p>
        <Button href="/careers" variant="secondary" showArrow>View Careers</Button>
      </div>
    </Container>
  </Section>

  <ReviewSection />
  <EmergencyCTA />
</BaseLayout>
