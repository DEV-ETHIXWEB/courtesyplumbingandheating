---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import PhoneButton from '../../components/ui/PhoneButton.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Reveal from '../../components/ui/Reveal.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import EmergencyCTA from '../../components/home/EmergencyCTA.astro';
import TrustStrip from '../../components/home/TrustStrip.astro';
import { ThermometerSun } from '@lucide/astro';
import { serviceFamilies, getServicesByFamily } from '../../data/services';

const family = serviceFamilies.hvac;
const allServices = getServicesByFamily('hvac');
const heatingServices = allServices.filter((s) =>
  ['heating-repair', 'furnace-repair', 'furnace-replacement', 'furnace-tune-up', 'boiler-repair', 'boiler-replacement', 'humidifier-installation'].includes(s.slug)
);
const coolingServices = allServices.filter((s) =>
  ['ac-repair', 'ac-replacement', 'cooling-repair', 'ac-tune-up', 'commercial-ac-repair'].includes(s.slug)
);
const otherServices = allServices.filter(
  (s) => !heatingServices.includes(s) && !coolingServices.includes(s)
);

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Heating & Cooling' }];

const faqs = [
  { question: 'Do you offer 24/7 emergency HVAC service?', answer: 'Yes. Courtesy provides 24/7 emergency heating and cooling service throughout Castle Rock and the Denver Metro area, with no trip fees.' },
  { question: 'How often should I have my HVAC system serviced?', answer: 'We recommend a furnace tune-up in the fall and an AC tune-up in the spring, once each per year, to catch small issues before they become expensive breakdowns.' },
  { question: 'Do you install new HVAC systems, not just repair them?', answer: 'Yes, we handle full installation and replacement for furnaces, air conditioners, heat pumps, boilers, and ductless mini splits, alongside repair and maintenance.' },
  { question: 'Are you licensed for HVAC work in Colorado?', answer: `Yes, Courtesy Plumbing & Heating is a licensed HVAC contractor serving Castle Rock and the greater Denver Metro area.` },
];

const title = 'HVAC Services in Castle Rock & Denver Metro, CO';
const description = 'Furnace, AC, heat pump, boiler, and mini split repair, replacement, and installation. Licensed, 24/7 emergency service, no trip fees.';
---

<BaseLayout title={title} description={description} canonical="/hvac">
  <BreadcrumbSchema items={breadcrumbItems} />
  <FAQSchema items={faqs} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <IconBadge icon={ThermometerSun} tone="white" size="lg" />
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Heating &amp; Cooling Services
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          {family.description} Licensed technicians, transparent pricing, and 24/7 availability throughout Castle Rock and the Denver Metro area.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="secondary" size="lg" showArrow>Schedule Service</Button>
          <PhoneButton variant="outline" size="lg" location="hvac_hub_hero" class="text-white" />
        </div>
      </div>
    </Container>
  </Section>

  <TrustStrip />

  <Section>
    <Container>
      <SectionHeading eyebrow="Heating" title="Furnace & Boiler Services" align="left" />
      <Reveal as="div" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" step={60}>
        {heatingServices.map((service) => <ServiceCard service={service} family="hvac" />)}
      </Reveal>
    </Container>
  </Section>

  <Section bg="subtle">
    <Container>
      <SectionHeading eyebrow="Cooling" title="Air Conditioning Services" align="left" />
      <Reveal as="div" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" step={60}>
        {coolingServices.map((service) => <ServiceCard service={service} family="hvac" />)}
      </Reveal>
    </Container>
  </Section>

  {otherServices.length > 0 && (
    <Section>
      <Container>
        <SectionHeading eyebrow="Additional Services" title="Installation & Specialty Systems" align="left" />
        <Reveal as="div" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" step={60}>
          {otherServices.map((service) => <ServiceCard service={service} family="hvac" />)}
        </Reveal>
      </Container>
    </Section>
  )}

  <Section bg="subtle">
    <Container>
      <SectionHeading eyebrow="FAQs" title="Heating & Cooling Questions" align="left" />
      <div class="mt-8 max-w-3xl">
        <FAQAccordion items={faqs} />
      </div>
    </Container>
  </Section>

  <EmergencyCTA />
</BaseLayout>
