---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import { Compass } from '@lucide/astro';

const popularLinks = [
  { label: 'Heating & Cooling', href: '/hvac' },
  { label: 'Plumbing', href: '/plumbing' },
  { label: 'Sewer & Drains', href: '/sewer' },
  { label: 'Service Areas', href: '/service-area' },
  { label: 'Specials & Coupons', href: '/coupons' },
  { label: 'Contact Us', href: '/contact' },
];

const title = 'Page Not Found';
const description = 'The page you\'re looking for could not be found.';
---

<BaseLayout title={title} description={description} noindex>
  <Section spacing="default">
    <Container>
      <div class="mx-auto flex max-w-xl flex-col items-center gap-5 text-center" data-reveal>
        <IconBadge icon={Compass} tone="blue" size="lg" />
        <p class="font-display text-sm font-bold uppercase tracking-widest text-brand-blue-600">404</p>
        <h1 class="text-balance font-display text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
          We Couldn't Find That Page
        </h1>
        <p class="text-balance leading-relaxed text-text-muted">
          The page you're looking for may have moved or no longer exists. Let's get you back on track, or reach
          out directly if you need help fast.
        </p>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <Button href="/" variant="primary" showArrow>Back to Homepage</Button>
          <PhoneButton variant="secondary" location="404_page" />
        </div>

        <div class="mt-8 w-full border-t border-border pt-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-text-muted">Popular Pages</p>
          <ul class="mt-4 flex flex-wrap justify-center gap-2">
            {popularLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-text transition-colors hover:border-brand-blue-300 hover:bg-brand-blue-50 hover:text-brand-blue-700"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
