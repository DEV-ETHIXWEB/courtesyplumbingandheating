---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import { Landmark, CheckCircle2 } from '@lucide/astro';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Rebates' }];

const eligibleUpgrades = [
  'High-efficiency furnaces and boilers',
  'ENERGY STAR-qualified air conditioners and heat pumps',
  'Tankless and high-efficiency water heaters',
  'Smart thermostats',
];

const title = 'Rebates & Tax Credits';
const description = 'Upgrading your HVAC system or water heater? Courtesy Plumbing & Heating can help you identify and maximize available rebates and tax credits.';
---

<BaseLayout title={title} description={description} canonical="/rebates">
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <IconBadge icon={Landmark} tone="white" size="lg" />
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Rebates &amp; Tax Credits
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          Upgrading your home's HVAC system or water heater? You could save with available rebates and tax
          credits. We'll help you find and claim what applies to your project.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="secondary" size="lg" showArrow>Ask About Rebates</Button>
          <PhoneButton variant="outline" size="lg" location="rebates_hero" class="text-white" />
        </div>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-start">
        <div data-reveal="left">
          <Eyebrow>What Qualifies</Eyebrow>
          <h2 class="mt-4 font-display text-2xl font-bold text-text sm:text-3xl">
            Equipment That May Be Eligible
          </h2>
          <p class="mt-4 leading-relaxed text-text-muted">
            Utility companies and federal programs periodically offer rebates and tax credits for qualifying
            high-efficiency equipment. Availability and amounts change over time and depend on your specific
            utility provider and the equipment installed, so we confirm current details before your installation.
          </p>
          <ul class="mt-6 space-y-3">
            {eligibleUpgrades.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text">
                <CheckCircle2 aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="card-elevated p-8" data-reveal="right">
          <h2 class="font-display text-lg font-bold text-text">We Help You Maximize Savings</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-muted">
            If you're planning to replace equipment in your home or business, give us a call before you buy.
            We'll help make sure you're aware of every rebate and tax credit available to you at the time of
            your project.
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <Button href="/contact" variant="primary" showArrow class="w-full">Schedule a Consultation</Button>
            <PhoneButton variant="secondary" location="rebates_sidebar" class="w-full" />
          </div>
          <a href="/financing" class="mt-5 inline-block text-sm font-semibold text-brand-blue-700 hover:text-brand-blue-800">
            Also exploring financing? See your options →
          </a>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
