---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import { Tag, PhoneCall } from '@lucide/astro';
import { coupons } from '../data/coupons';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Specials & Coupons' }];

const title = 'Specials & Coupons';
const description = 'Current specials and coupons from Courtesy Plumbing & Heating. Mention any active offer to your technician for redemption.';
---

<BaseLayout title={title} description={description} canonical="/coupons">
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <Eyebrow tone="dark">Save on Service</Eyebrow>
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Specials &amp; Coupons
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          Mention any current coupon or special to your technician at the time of service to redeem it.
        </p>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      {coupons.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {coupons.map((c) => {
            const isCurrency = c.amount.startsWith('$');
            const amountValue = c.amount.replace(/^\$/, '');
            return (
            <div class:list={['offer-ticket', { 'offer-ticket--featured': c.featured }]} data-reveal>
              <div class="offer-ticket__notch offer-ticket__notch--left" aria-hidden="true"></div>
              <div class="offer-ticket__notch offer-ticket__notch--right" aria-hidden="true"></div>
              <div class="flex flex-col p-6">
                <div class="offer-ticket__eyebrow">
                  <span></span>
                  <span>Special</span>
                  <span></span>
                </div>
                <p class="offer-ticket__amount">
                  {isCurrency && <span class="offer-ticket__currency">$</span>}
                  {amountValue}
                  {c.amountSuffix && <span class="offer-ticket__suffix">{c.amountSuffix}</span>}
                </p>
                <p class="mt-1 font-display text-lg font-extrabold uppercase tracking-tight text-text">{c.title}</p>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">{c.description}</p>
                <div class="offer-ticket__divider" aria-hidden="true"></div>
                {c.restrictions && <p class="text-xs leading-relaxed text-text-muted">{c.restrictions}</p>}
                {c.expires && <p class="mt-1.5 text-xs font-semibold text-brand-red-600">Expires {c.expires}</p>}
              </div>
            </div>
            );
          })}
        </div>
      ) : (
        <div class="card-elevated mx-auto flex max-w-xl flex-col items-center gap-4 p-10 text-center" data-reveal>
          <IconBadge icon={Tag} tone="blue" size="lg" />
          <h2 class="font-display text-xl font-bold text-text">Current Specials Are Being Updated</h2>
          <p class="text-text-muted">
            Give us a call and we'll let you know about any current promotions or specials available for your
            service, plus straightforward, transparent pricing on the work itself.
          </p>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            <PhoneButton variant="primary" location="coupons_empty_state" />
            <Button href="/contact" variant="secondary" showArrow>Schedule Service</Button>
          </div>
        </div>
      )}
    </Container>
  </Section>

  <Section bg="subtle">
    <Container>
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <PhoneCall aria-hidden="true" class="size-8 text-brand-blue-600" />
        <h2 class="font-display text-2xl font-bold text-text">Have Questions About Pricing?</h2>
        <p class="max-w-lg text-text-muted">
          Courtesy offers transparent pricing with no trip fees on every call. Contact us and we'll walk you
          through exactly what your service will cost before we start.
        </p>
        <PhoneButton variant="primary" size="lg" location="coupons_footer_cta" />
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .offer-ticket {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: transform 300ms var(--ease-out-quart), box-shadow 300ms var(--ease-out-quart);
  }
  .offer-ticket:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }
  .offer-ticket__notch {
    position: absolute;
    top: 50%;
    width: 1.5rem;
    height: 1.5rem;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
  }
  .offer-ticket__notch--left { left: -0.8125rem; }
  .offer-ticket__notch--right { right: -0.8125rem; }

  .offer-ticket::before {
    content: '';
    position: absolute;
    inset: 0.625rem;
    border: 1.5px dashed var(--color-brand-blue-200);
    border-radius: calc(var(--radius-lg) - 0.375rem);
    pointer-events: none;
  }

  .offer-ticket__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-brand-red-600);
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .offer-ticket__eyebrow span:not(:nth-child(2)) {
    flex: 1;
    height: 1px;
    background: var(--color-brand-red-200);
  }

  .offer-ticket__amount {
    margin-top: 0.875rem;
    display: flex;
    align-items: flex-start;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--color-brand-navy);
    letter-spacing: -0.02em;
  }

  .offer-ticket__currency {
    margin-top: 0.375rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand-blue-600);
  }

  .offer-ticket__suffix {
    align-self: flex-end;
    margin-left: 0.375rem;
    margin-bottom: 0.375rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-brand-red-600);
  }

  .offer-ticket__divider {
    margin: 1rem 0 0.75rem;
    border-top: 1px dashed var(--color-border-strong);
  }

  .offer-ticket--featured {
    border-color: var(--color-brand-red-200);
    box-shadow: 0 1px 0 0 rgba(255, 255, 255, 0.4) inset, 0 8px 20px -10px rgb(194 42 46 / 0.25);
  }

  .offer-ticket--featured::before {
    border-color: var(--color-brand-red-200);
  }

  @media (prefers-reduced-motion: reduce) {
    .offer-ticket {
      transition: none;
    }
  }
</style>
