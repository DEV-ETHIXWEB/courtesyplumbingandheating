---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import PhoneButton from '../../components/ui/PhoneButton.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import ServiceAreaMap from '../../components/location/ServiceAreaMap.tsx';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import EmergencyCTA from '../../components/home/EmergencyCTA.astro';
import { MapPin, ArrowUpRight } from '@lucide/astro';
import { locations } from '../../data/locations';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Service Areas' }];
const sortedLocations = [...locations].sort((a, b) => a.name.localeCompare(b.name));

const title = 'Service Area: Castle Rock & Denver Metro, CO';
const description = `Courtesy Plumbing & Heating proudly serves Castle Rock and ${locations.length}+ communities across the Denver Metro area with plumbing, heating, and cooling service.`;
---

<BaseLayout title={title} description={description} canonical="/service-area">
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <IconBadge icon={MapPin} tone="white" size="lg" />
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Proudly Serving Castle Rock &amp; the Denver Metro Area
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          From Castle Rock to Denver, Aurora, Parker, and beyond, Courtesy brings licensed plumbing, heating, and cooling service to {locations.length}+ communities, with transparent pricing and no trip fees.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="secondary" size="lg" showArrow>Schedule Service</Button>
          <PhoneButton variant="outline" size="lg" location="service_area_hero" class="text-white" />
        </div>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <SectionHeading
        eyebrow="Interactive Map"
        title="Find Your Community"
        description="Select any city below to see local service details, or browse the full list."
      />
      <div class="mt-10" data-reveal>
        <ServiceAreaMap locations={locations} client:visible />
      </div>
    </Container>
  </Section>

  <Section bg="subtle">
    <Container>
      <SectionHeading eyebrow="All Communities" title="Every City We Serve" align="left" />
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4" data-reveal>
        {sortedLocations.map((loc) => (
          <li>
            {loc.hasPage ? (
              <a
                href={`/service-area/${loc.slug}`}
                class="card-elevated group flex items-center justify-between gap-2 p-4"
              >
                <span class="text-sm font-semibold text-text">{loc.name}</span>
                <ArrowUpRight aria-hidden="true" class="size-4 shrink-0 text-brand-blue-600 transition-transform duration-300 ease-(--ease-out-quart) group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </a>
            ) : (
              <div class="flex items-center gap-2 rounded-(--radius-lg) border border-border bg-surface p-4">
                <MapPin aria-hidden="true" class="size-4 shrink-0 text-text-muted" />
                <span class="text-sm font-medium text-text-muted">{loc.name}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-text-muted" data-reveal>
        Don't see your city, or unsure if you're in our service area? <a href="/contact" class="font-semibold text-brand-blue-700 hover:text-brand-blue-800">Contact us</a> and we'll let you know.
      </p>
    </Container>
  </Section>

  <EmergencyCTA />
</BaseLayout>
