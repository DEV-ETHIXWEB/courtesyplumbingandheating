---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import PhoneButton from '../../components/ui/PhoneButton.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import Reveal from '../../components/ui/Reveal.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import EmergencyCTA from '../../components/home/EmergencyCTA.astro';
import { MapPin, CheckCircle2, Navigation } from '@lucide/astro';
import { locations } from '../../data/locations';
import { services, serviceFamilies } from '../../data/services';
import { business } from '../../data/business';

export function getStaticPaths() {
  return locations
    .filter((l) => l.hasPage && l.content)
    .map((location) => ({ params: { location: location.slug }, props: { location } }));
}

const { location } = Astro.props;
const content = location.content!;

const featuredServices = services.filter((s) =>
  ['ac-repair', 'heating-repair', 'drain-cleaning', 'water-heater-repair', 'sewer-repair', 'furnace-repair'].includes(s.slug)
);

const nearbyLocations = locations
  .filter((l) => l.slug !== location.slug)
  .slice(0, 8);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-area' },
  { label: location.name },
];

const title = `Plumbing, Heating & Cooling in ${location.name}, CO`;
const description = `${content.intro} Licensed, 24/7 emergency service, no trip fees.`;
---

<BaseLayout title={title} description={description} canonical={`/service-area/${location.slug}`}>
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <IconBadge icon={MapPin} tone="white" size="lg" />
        {location.primary && (
          <span class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-brand-blue-500/15 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-brand-blue-200 ring-1 ring-inset ring-brand-blue-400/30">
            Headquarters City
          </span>
        )}
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Plumbing, Heating &amp; Cooling in {location.name}, CO
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          {content.intro}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="secondary" size="lg" showArrow>Schedule Service</Button>
          <PhoneButton variant="outline" size="lg" location={`location_hero_${location.slug}`} class="text-white" />
        </div>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <SectionHeading
            eyebrow={`Serving ${location.name}`}
            title={`Local, Licensed Service in ${location.name}`}
            align="left"
          />
          <div class="mt-6 space-y-4" data-reveal>
            {content.localContext.map((paragraph) => (
              <p class="leading-relaxed text-text-muted">{paragraph}</p>
            ))}
          </div>

          {content.neighborhoods.length > 0 && (
            <div class="mt-8" data-reveal>
              <h2 class="font-display text-sm font-bold uppercase tracking-wide text-text-muted">
                Areas We Serve in {location.name}
              </h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {content.neighborhoods.map((n) => (
                  <span class="inline-flex items-center rounded-full border border-border bg-surface-subtle px-3.5 py-1.5 text-sm text-text">
                    {n}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="lg:col-span-1">
          <div class="card-elevated p-6" data-reveal>
            <h2 class="font-display text-lg font-bold text-text">Why {location.name} Chooses Courtesy</h2>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-2.5 text-sm text-text">
                <CheckCircle2 aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                24/7 emergency availability, no trip fees
              </li>
              <li class="flex items-start gap-2.5 text-sm text-text">
                <CheckCircle2 aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                Licensed Colorado plumbing contractor, #{business.license.plumbing}
              </li>
              <li class="flex items-start gap-2.5 text-sm text-text">
                <CheckCircle2 aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                {business.yearsInBusiness} years serving the Denver Metro area
              </li>
            </ul>
            <div class="mt-6 flex flex-col gap-3">
              <Button href="/contact" variant="primary" showArrow class="w-full">Schedule Service</Button>
              <PhoneButton variant="secondary" location={`location_sidebar_${location.slug}`} class="w-full" />
            </div>
          </div>
        </aside>
      </div>
    </Container>
  </Section>

  <Section bg="subtle">
    <Container>
      <SectionHeading
        eyebrow="Popular Services"
        title={`Frequently Requested in ${location.name}`}
        align="left"
      />
      <Reveal as="div" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" step={60}>
        {featuredServices.map((s) => <ServiceCard service={s} family={s.family} />)}
      </Reveal>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        {(['hvac', 'plumbing', 'sewer'] as const).map((fam) => (
          <a
            href={`/${fam}`}
            class="inline-flex items-center gap-1.5 rounded-full border-2 border-brand-blue-600 px-4 py-2 text-sm font-semibold text-brand-blue-700 hover:bg-brand-blue-50"
          >
            All {serviceFamilies[fam].name} Services
          </a>
        ))}
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <SectionHeading eyebrow="Nearby" title="Other Communities We Serve" align="left" />
      <div class="mt-8 flex flex-wrap gap-2" data-reveal>
        {nearbyLocations.map((loc) => (
          <a
            href={loc.hasPage ? `/service-area/${loc.slug}` : '/service-area'}
            class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3.5 py-2 text-sm font-medium text-text-muted transition-colors hover:border-brand-blue-300 hover:bg-brand-blue-50 hover:text-brand-blue-700"
          >
            <Navigation aria-hidden="true" class="size-3.5" />
            {loc.name}
          </a>
        ))}
        <a href="/service-area" class="inline-flex items-center gap-1.5 rounded-full bg-brand-blue-600 px-3.5 py-2 text-sm font-semibold text-white hover:bg-brand-blue-700">
          View full service area
        </a>
      </div>
    </Container>
  </Section>

  <EmergencyCTA />
</BaseLayout>
