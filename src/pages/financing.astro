---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Reveal from '../components/ui/Reveal.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import { Wallet, Zap, ShieldCheck, Laptop, ListChecks, CalendarClock } from '@lucide/astro';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Financing' }];

const points = [
  { icon: Wallet, title: 'Finance Up to $55,000', description: 'Cover the cost of a new furnace, AC, water heater, or larger project.' },
  { icon: Zap, title: 'Instant Decisions', description: 'A simple, fast application with decisions in minutes, not days.' },
  { icon: Laptop, title: 'Fully Digital', description: 'Apply entirely online, no paperwork or branch visits required.' },
  { icon: ShieldCheck, title: 'No Credit Impact to Check', description: 'View loan offers with a soft credit pull that doesn\'t affect your credit score.' },
  { icon: ListChecks, title: 'Multiple Offers', description: 'Qualified borrowers can compare multiple loan offers and choose what fits best.' },
  { icon: CalendarClock, title: 'No Early Payment Penalties', description: 'Pay off your loan ahead of schedule with no added fees.' },
];

const title = 'Financing Options';
const description = 'Finance your plumbing, heating, or cooling project with Courtesy Plumbing & Heating. Fast, digital financing up to $55,000 through BuyFin.';
---

<BaseLayout title={title} description={description} canonical="/financing">
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <Eyebrow tone="dark">Flexible Payment Options</Eyebrow>
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Affordable Financing Options
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          We work with BuyFin to offer financing that's simple, fast, and affordable, so you can pay for your home
          project over time.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="secondary" size="lg" showArrow>Ask About Financing</Button>
          <PhoneButton variant="outline" size="lg" location="financing_hero" class="text-white" />
        </div>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <SectionHeading eyebrow="How It Works" title="Financing Built for Home Projects" />
      <Reveal as="div" class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" step={70}>
        {points.map((p) => (
          <div class="card-elevated flex flex-col items-start gap-3 p-6" data-reveal>
            <IconBadge icon={p.icon} tone="blue" size="md" />
            <h3 class="font-display text-base font-bold text-text">{p.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted">{p.description}</p>
          </div>
        ))}
      </Reveal>
    </Container>
  </Section>

  <Section bg="subtle">
    <Container>
      <div class="card-elevated mx-auto flex max-w-2xl flex-col items-center gap-4 p-10 text-center" data-reveal>
        <h2 class="font-display text-2xl font-bold text-text">See If You Pre-Qualify</h2>
        <p class="text-text-muted">
          Contact us today to see if you pre-qualify, with no impact on your credit score. We'll walk you through
          the options for your project.
        </p>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact" variant="primary" showArrow>Get Started</Button>
          <PhoneButton variant="secondary" location="financing_footer_cta" />
        </div>
        <p class="mt-4 max-w-lg text-xs leading-relaxed text-text-muted">
          BuyFin, powered by Momnt Technologies, Inc., arranges consumer loans used to purchase goods and services
          from participating merchant businesses. All loans are originated by participating financial institutions.
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
