---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ContactForm from '../components/forms/ContactForm.tsx';
import { Phone, Mail, MapPin, Clock, ShieldCheck, Star } from '@lucide/astro';
import { business } from '../data/business';
import { ratingSummary, testimonials } from '../data/testimonials';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Contact' }];

const title = 'Contact Us: Schedule Service';
const description = 'Schedule plumbing, heating, or cooling service with Courtesy Plumbing & Heating. Available 24/7 with transparent pricing and no trip fees.';

const mapQuery = encodeURIComponent(business.address.full);
const featuredReview = testimonials[0];
---

<BaseLayout title={title} description={description} canonical="/contact">
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <Eyebrow tone="dark">Available 24/7</Eyebrow>
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Schedule Service or Get in Touch
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          Fill out the form below or call us directly, day or night. Transparent pricing, no trip fees, always.
        </p>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="overflow-hidden rounded-(--radius-xl) border border-border shadow-elevated" data-reveal>
        <div class="grid grid-cols-1 lg:grid-cols-5">
          <!-- Dark info panel -->
          <div class="relative overflow-hidden bg-[linear-gradient(165deg,var(--color-brand-blue-900)_0%,var(--color-brand-navy)_60%,var(--color-neutral-950)_100%)] p-7 text-white sm:p-9 lg:col-span-2">
            <div
              class="pointer-events-none absolute inset-0 opacity-[0.06]"
              aria-hidden="true"
              style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 26px 26px;"
            ></div>

            <div class="relative flex h-full flex-col justify-between gap-8">
              <div>
                <h2 class="font-display text-xl font-extrabold tracking-tight text-white sm:text-2xl">
                  Same-day callbacks during business hours.
                </h2>
                <p class="mt-2.5 text-sm leading-relaxed text-white/70">
                  After hours, use the emergency line for live dispatch, we're answered 24/7.
                </p>

                <div class="mt-6 space-y-2.5">
                  <a href={business.phone.href} class="a-info-row">
                    <span class="a-info-row__icon"><Phone aria-hidden="true" class="size-4" /></span>
                    <span>
                      <span class="a-info-row__label">Call</span>
                      <span class="a-info-row__value">{business.phone.display}</span>
                    </span>
                  </a>
                  <a href={business.email.href} class="a-info-row">
                    <span class="a-info-row__icon"><Mail aria-hidden="true" class="size-4" /></span>
                    <span>
                      <span class="a-info-row__label">Email</span>
                      <span class="a-info-row__value">{business.email.display}</span>
                    </span>
                  </a>
                  <div class="a-info-row">
                    <span class="a-info-row__icon"><MapPin aria-hidden="true" class="size-4" /></span>
                    <span>
                      <span class="a-info-row__label">Castle Rock office</span>
                      <span class="a-info-row__value">{business.address.full}</span>
                    </span>
                  </div>
                  <div class="a-info-row">
                    <span class="a-info-row__icon"><MapPin aria-hidden="true" class="size-4" /></span>
                    <span>
                      <span class="a-info-row__label">Federal Heights office</span>
                      <span class="a-info-row__value">{business.secondaryAddress.full}</span>
                    </span>
                  </div>
                  <div class="a-info-row">
                    <span class="a-info-row__icon"><Clock aria-hidden="true" class="size-4" /></span>
                    <span>
                      <span class="a-info-row__label">Hours</span>
                      <span class="a-info-row__value">{business.hours.display}</span>
                    </span>
                  </div>
                  <div class="a-info-row">
                    <span class="a-info-row__icon"><ShieldCheck aria-hidden="true" class="size-4" /></span>
                    <span>
                      <span class="a-info-row__label">Licensed</span>
                      <span class="a-info-row__value">#{business.license.plumbing}</span>
                    </span>
                  </div>
                </div>

                <PhoneButton variant="secondary" location="contact_page_sidebar" class="mt-6 w-full justify-center" />
              </div>

              {featuredReview && (
                <div class="relative rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
                  <div class="flex items-center gap-1">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <Star aria-hidden="true" class={`size-3.5 ${i < Math.round(ratingSummary.average) ? 'fill-amber-400 text-amber-400' : 'text-white/25'}`} />
                    ))}
                    <span class="ml-1.5 text-xs font-semibold text-white/70">{ratingSummary.average} · {ratingSummary.count} Google reviews</span>
                  </div>
                  <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-white/80">
                    "{featuredReview.quote}"
                  </p>
                  <p class="mt-3 text-xs font-bold text-white">{featuredReview.author}</p>
                </div>
              )}
            </div>
          </div>

          <!-- Form panel -->
          <div class="bg-white p-7 sm:p-9 lg:col-span-3">
            <h2 class="font-display text-xl font-bold text-text sm:text-2xl">Request your free estimate</h2>
            <p class="mt-1.5 text-sm text-text-muted">Typical response within 1 business hour.</p>
            <div class="mt-7">
              <ContactForm client:load business={{ phoneDisplay: business.phone.display, phoneHref: business.phone.href }} />
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-(--radius-lg) border border-border" data-reveal>
        <iframe
          title={`Map showing ${business.address.full}`}
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          width="100%"
          height="280"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </Container>
  </Section>

  <style>
    .a-info-row {
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
      border-radius: var(--radius-md);
      padding: 0.5rem 0.625rem;
      margin-left: -0.625rem;
      transition: background-color 150ms var(--ease-out-quart);
    }

    a.a-info-row:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .a-info-row__icon {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      margin-top: 0.125rem;
      color: rgba(255, 255, 255, 0.55);
    }

    .a-info-row__label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: rgba(255, 255, 255, 0.5);
    }

    .a-info-row__value {
      display: block;
      margin-top: 0.0625rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: white;
    }
  </style>
</BaseLayout>
