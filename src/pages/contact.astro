---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ContactForm from '../components/forms/ContactForm.tsx';
import { Phone, Mail, MapPin, Clock, ShieldCheck } from '@lucide/astro';
import { business } from '../data/business';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Contact' }];

const title = 'Contact Us — Schedule Service';
const description = 'Schedule plumbing, heating, or cooling service with Courtesy Plumbing & Heating. Available 24/7 with transparent pricing and no trip fees.';

const mapQuery = encodeURIComponent(business.address.full);
---

<BaseLayout title={title} description={description} canonical="/contact">
  <BreadcrumbSchema items={breadcrumbItems} />

  <Section spacing="compact" bg="navy" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <Container class="relative">
      <Breadcrumb items={breadcrumbItems} class="mb-6 [&_a]:text-text-inverse-muted [&_a:hover]:text-white [&_span]:text-white" />
      <div class="max-w-2xl" data-reveal>
        <Eyebrow tone="dark">Available 24/7</Eyebrow>
        <h1 class="mt-5 text-balance font-display text-3xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-4xl md:text-5xl">
          Schedule Service or Get in Touch
        </h1>
        <p class="mt-5 max-w-xl text-balance text-lg leading-relaxed text-text-inverse-muted">
          Fill out the form below or call us directly, day or night. Transparent pricing, no trip fees, always.
        </p>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <div class="card-elevated p-6 sm:p-8" data-reveal>
            <h2 class="font-display text-xl font-bold text-text">Request Service</h2>
            <p class="mt-1.5 text-sm text-text-muted">We'll get back to you as quickly as possible.</p>
            <div class="mt-6">
              <ContactForm client:load business={{ phoneDisplay: business.phone.display, phoneHref: business.phone.href }} />
            </div>
          </div>
        </div>

        <div class="lg:col-span-2">
          <div class="flex flex-col gap-5">
            <div class="card-elevated p-6" data-reveal>
              <div class="flex items-center gap-3">
                <IconBadge icon={Phone} tone="red" size="sm" />
                <h2 class="font-display text-lg font-bold text-text">Emergency? Call Now</h2>
              </div>
              <p class="mt-3 text-sm text-text-muted">
                Available 24/7 for plumbing and HVAC emergencies, no trip fees.
              </p>
              <div class="mt-4">
                <PhoneButton variant="primary" location="contact_page_sidebar" class="w-full" />
              </div>
            </div>

            <div class="card-elevated p-6" data-reveal>
              <h2 class="font-display text-lg font-bold text-text">Contact Information</h2>
              <div class="mt-4 space-y-4 text-sm">
                <div class="flex items-start gap-3">
                  <MapPin aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                  <div>
                    <p class="font-semibold text-text">Castle Rock Office</p>
                    <p class="text-text-muted">{business.address.full}</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <MapPin aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                  <div>
                    <p class="font-semibold text-text">Federal Heights Office</p>
                    <p class="text-text-muted">{business.secondaryAddress.full}</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Mail aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                  <a href={business.email.href} class="text-text-muted hover:text-brand-blue-700">{business.email.display}</a>
                </div>
                <div class="flex items-start gap-3">
                  <Clock aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                  <p class="text-text-muted">{business.hours.display}</p>
                </div>
                <div class="flex items-start gap-3">
                  <ShieldCheck aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-blue-600" />
                  <p class="text-text-muted">Licensed — #{business.license.plumbing}</p>
                </div>
              </div>
            </div>

            <div class="overflow-hidden rounded-(--radius-lg) border border-border" data-reveal>
              <iframe
                title={`Map showing ${business.address.full}`}
                src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
                width="100%"
                height="260"
                style="border:0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
